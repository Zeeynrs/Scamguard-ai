# ===== ScamGuard Multimodal — environment =====

# --- LLM (intent tactic classifier) ---
# Provider: openai | groq | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (free tier fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (fully local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b-instruct

# --- Speech-to-text ---
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Language: "auto" for code-switched ID/EN, or pin "id" / "en"
STT_LANGUAGE=auto

# --- Audio deepfake ---
DEEPFAKE_MODEL_PATH=
DEEPFAKE_ENABLED=true

# --- Vision ---
VISION_ENABLED=true
VISION_FPS=12

# --- Fusion weights (must sum to 1.0) ---
# Intent text signal is the most reliable -> highest weight
WEIGHT_INTENT_LLM=0.55
WEIGHT_INTENT_RULES=0.25
WEIGHT_AUDIO=0.12
WEIGHT_VIDEO=0.08

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
