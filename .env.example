# ===== ScamGuard Multimodal — environment =====

# --- LLM (intent tactic classifier) ---
# Provider: openai | groq | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (free tier fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (fully local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b-instruct

# --- Speech-to-text ---
# Provider: auto | groq | local  (auto = Groq first, local fallback)
STT_PROVIDER=auto
# Groq Whisper model (fast, accurate, offloads CPU)
GROQ_STT_MODEL=whisper-large-v3
# Local fallback model: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Language: "auto" for code-switched ID/EN, or pin "id" / "en"
STT_LANGUAGE=auto

# --- Audio deepfake ---
DEEPFAKE_MODEL_PATH=
DEEPFAKE_ENABLED=true

# --- Vision ---
VISION_ENABLED=true
VISION_FPS=12

# --- Fusion weights (must sum to 1.0) ---
# Intent text signal is the most reliable -> highest weight
WEIGHT_INTENT_LLM=0.55
WEIGHT_INTENT_RULES=0.25
WEIGHT_AUDIO=0.12
WEIGHT_VIDEO=0.08

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Security (demo hardening) ---
# "production" hides /docs and enforces CORS + rate limiting. "development" is permissive.
ENVIRONMENT=production
# Comma-separated allowed browser origins (production only)
CORS_ORIGINS=https://scamguard.parallel-dungeons.site,http://localhost:3000
# Per-IP rate limit
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Max upload size in MB
MAX_UPLOAD_MB=25
# Optional shared access code. Empty = open demo. If set, send header X-Access-Code.
ACCESS_CODE=

# --- Telegram bot (dual mode) ---
# Token used by BOTH the polling bot container and backend webhook mode.
TELEGRAM_BOT_TOKEN=
# Set BOT_WEBHOOK_URL to run the bot via webhook through the backend instead of
# the polling container. Empty = polling mode (bot container runs long polling).
# When set, the bot container stays idle (compose profile "polling") and Telegram
# delivers updates to POST /api/bot/webhook.
# Example: https://api.parallel-dungeons.site/api/bot/webhook
BOT_WEBHOOK_URL=
# Optional secret. Sent to Telegram on set_webhook and verified on every incoming
# update via the X-Telegram-Bot-Api-Secret-Token header. Recommended in production.
BOT_WEBHOOK_SECRET=

# --- Frontend (build-time) ---
# Base URL the BROWSER calls. Baked into the JS bundle at `docker compose build`,
# so it MUST be the public API host — never http://localhost:8000 in production,
# or every visitor's "Analyze" hits their own device and fails.
NEXT_PUBLIC_API_URL=https://api.parallel-dungeons.site
